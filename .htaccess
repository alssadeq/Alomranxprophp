# .htaccess — موقع العمران الذهبية (نسخة PHP)
# الملفات الثابتة تُخدم مباشرة، وكل ما عداها يمر عبر index.php.

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# المجلدات الداخلية والبيانات لا تُفتح من المتصفح أبداً
RewriteRule ^(app|data)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(md|json|lock|log|sh|bak|tmp|ini|dist)$ - [F,L,NC]

# صفحات HTML تمر عبر index.php (لإضافة الإعدادات والروابط النظيفة)
RewriteRule \.html?$ index.php [L,QSA,NC]

# الملفات الموجودة فعلاً (css, js, fonts, images) تُخدم مباشرة
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# كل ما عدا ذلك
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
<FilesMatch "\.(css|js|woff2?|ttf|otf|png|jpe?g|webp|svg|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.svg$">
Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# حجم الرفع لنموذج طلب المشروع (المرفقات حتى 60MB)
<IfModule mod_php.c>
php_value upload_max_filesize 16M
php_value post_max_size 64M
php_value max_file_uploads 12
</IfModule>
<IfModule lsapi_module>
php_value upload_max_filesize 16M
php_value post_max_size 64M
php_value max_file_uploads 12
</IfModule>
